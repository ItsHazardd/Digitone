        <Button x:Name="AddFolderButton" Content="+ Folder" Margin="0,0,8,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
        <Button x:Name="AddFilesButton" Content="+ Files" Background="Transparent" Margin="0,0,8,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
      </StackPanel>
    </Grid>
    <Grid x:Name="ContentStage" Grid.Row="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.85*" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>
      <Canvas x:Name="AmbientCanvas" Grid.ColumnSpan="2" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.42" ClipToBounds="True">
          <Polygon x:Name="AmbientBand" Points="0,340 1100,0 1100,70 0,450" Fill="{DynamicResource B354233}" />
          <Ellipse x:Name="AmbientRing" Canvas.Left="-80" Canvas.Top="-40" Width="570" Height="570" Stroke="{DynamicResource BC1D3A8}" StrokeThickness="2" StrokeDashArray="100 50 2 50" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
          <Ellipse x:Name="AmbientOrbit" Canvas.Left="740" Canvas.Top="220" Width="420" Height="420" Stroke="{DynamicResource BC1D3A8}" StrokeThickness="1.5" StrokeDashArray="90 170 4 90" Opacity="0.45" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
        <Line x:Name="AmbientDots" Stroke="{DynamicResource BC1D3A8}" StrokeThickness="2" StrokeDashArray="1 9" StrokeDashCap="Round" Opacity="0.38" />
        <Polygon x:Name="AmbientShard" Stroke="{DynamicResource BC1D3A8}" StrokeThickness="1.5" Fill="{DynamicResource B354233}" Opacity="0.24" Visibility="Collapsed"><Polygon.RenderTransform><TranslateTransform/></Polygon.RenderTransform></Polygon>
        <Polyline x:Name="AmbientSteps" Stroke="{DynamicResource BC1D3A8}" StrokeThickness="2" Opacity="0.38" Visibility="Collapsed"><Polyline.RenderTransform><TranslateTransform/></Polyline.RenderTransform></Polyline>
      </Canvas>
      <Border x:Name="NowPane" Grid.Column="0" Background="Transparent" CornerRadius="0" Margin="22,0,10,12" BorderBrush="{DynamicResource BC1D3A8}" BorderThickness="0,3,0,0" Padding="20,16,20,14" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="NOW PLAYING" Foreground="{StaticResource Muted}" FontSize="11" />
          <Border x:Name="RecordArt" Grid.Row="1" Panel.ZIndex="0" Background="Transparent" CornerRadius="0" Margin="0,10,0,4" ClipToBounds="True" MinHeight="0">
            <Grid>
              <Image x:Name="CoverArt" Stretch="UniformToFill" Visibility="Collapsed" />
              <Viewbox x:Name="DefaultArt">
                <Grid x:Name="RecordDisc" Width="228" Height="228" RenderTransformOrigin="0.5,0.5">
                  <Grid.RenderTransform>
                    <RotateTransform />
                  </Grid.RenderTransform>
                  <Ellipse Width="186" Height="186" Fill="{DynamicResource B161D19}" Stroke="{DynamicResource B657460}" StrokeThickness="1" />
                  <Ellipse Width="164" Height="164" Stroke="{DynamicResource B303B31}" StrokeThickness="12" />
                  <Ellipse Width="132" Height="132" Stroke="{DynamicResource B3B483B}" StrokeThickness="1" />
                  <Ellipse Width="109" Height="109" Stroke="{DynamicResource B303B31}" StrokeThickness="1" />
                  <Ellipse x:Name="RecordImage" Width="176" Height="176" />
                  <Ellipse x:Name="RecordLabel" Width="82" Height="82" Opacity="0.95" Fill="{DynamicResource BBACBA5}" />
                  <Image x:Name="RecordLogo" Width="54" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Viewbox>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Panel.ZIndex="1" Background="Transparent">
            <TextBlock x:Name="NowTitle" Text="Find your quiet." FontFamily="{DynamicResource ThemeDisplayFont}" FontStyle="Italic" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NowDetail" Text="Choose something worth listening to." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="VisualizerButton" Content="Waveform" ToolTip="Show the live waveform" Padding="8,5" FontSize="10" />
              <Button x:Name="MainSpectrumButton" Content="Spectrum" ToolTip="Show the live frequency spectrum" Padding="8,5" FontSize="10" />
              <Button x:Name="MainVisualizerOffButton" Content="Off" ToolTip="Hide the main visualizer" Padding="8,5" FontSize="10" />
              <Button x:Name="ExpandWaveformButton" Content="⛶ Expand" ToolTip="Expand the waveform (F11 for fullscreen)" Padding="8,5" FontSize="10" Margin="0" />
            </StackPanel>
            <Canvas x:Name="Waveform" Height="64" Background="Transparent" Cursor="Arrow" ClipToBounds="True" />
            <Canvas x:Name="MainSpectrum" Height="64" Background="Transparent" ClipToBounds="True" Visibility="Collapsed" />
            <TextBlock x:Name="WaveLabel" Text="Play a song to see its waveform" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,6,0,16" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="LibraryPane" Grid.Column="1" Margin="14,0,24,12" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="CollectionHeader" Grid.Row="1" Margin="0,24,0,22">
          <Border Background="{DynamicResource BEEEFE8}" HorizontalAlignment="Left" Padding="20,6,34,8" Margin="0,2,10,6">
            <Border.RenderTransform>
              <RotateTransform Angle="-2" />
            </Border.RenderTransform>
            <Viewbox MaxWidth="650" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="CollectionTitle" Text="Library" FontSize="52" FontFamily="{DynamicResource ThemeDisplayFont}" FontStyle="Italic" FontWeight="Bold" Foreground="{DynamicResource B161917}" TextTrimming="None" /></Viewbox>
          </Border>
          <TextBlock x:Name="CollectionSubtitle" Text="Bring your music. Leave everything else behind." Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Search" ToolTip="Search filenames or folders" AutomationProperties.Name="Search music" />
          <TextBlock x:Name="SearchHint" Text="Search your music…" Foreground="{StaticResource Muted}" Margin="13,10" IsHitTestVisible="False" />
          <Button Grid.Column="1" x:Name="PlayAllButton" Content="▶  Play all" Margin="10,0,0,0" />
        </Grid>
        <Grid Grid.Row="3">
          <ListBox x:Name="Tracks" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="48" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="♪" FontSize="20" Foreground="{DynamicResource BA9BE96}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource B919A92}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Format}" Foreground="{DynamicResource B919A92}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
            <TextBlock Text="♫" FontSize="44" Foreground="{DynamicResource BA9BE96}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="Your collection starts here" FontSize="19" HorizontalAlignment="Center" Margin="0,15,0,8" />
            <TextBlock x:Name="EmptyDescription" Text="Add a folder or drop audio files into this window.&#xA;Your originals stay exactly where they are." TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="21" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
          <WrapPanel>
            <Button x:Name="AddToPlaylistButton" Content="＋ To playlist" Padding="11,8" FontSize="11" />
            <Button x:Name="AddQueueButton" Content="＋ Queue" Padding="11,8" FontSize="11" />
            <Button x:Name="FavoriteButton" Content="♡ Favorite" Padding="11,8" FontSize="11" />
            <Button x:Name="LyricsButton" Content="Lyrics" Padding="11,8" FontSize="11" />
            <Button x:Name="DeletePlaylistButton" Content="Delete playlist" Padding="11,8" FontSize="11" Background="Transparent" Visibility="Collapsed" />
</WrapPanel>
          <TextBlock x:Name="Status" Text="Ready when you are." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid x:Name="DownloadPane" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" Margin="32,32,32,20" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid MinHeight="590">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="COLLECTION / IMPORT" FontSize="10" Foreground="{StaticResource Muted}" />
              <TextBlock Text="Downloads" FontSize="44" FontFamily="{DynamicResource ThemeDisplayFont}" FontStyle="Italic" FontWeight="Bold" Margin="0,22,0,8" />
              <TextBlock Text="Download a track or an entire playlist." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="1" Background="Transparent" CornerRadius="0" Padding="0,14" Margin="0,20,0,20">
              <TextBlock Text="Paste a link, choose a folder, and build your collection. Finished tracks appear in your library." Foreground="{DynamicResource BBDCCB0}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="YouTubeToggle" Content="▶  Open YouTube viewer" Background="{DynamicResource BC1D3A8}" Foreground="{DynamicResource B20291E}" />
                <TextBlock Text="Browse recommendations or sign in inside a separate Digitone window." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="3">
              <TextBlock Text="AUDIO OR VIDEO LINK" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,8" />
              <TextBox x:Name="DownloadUrl" MaxLength="4096" AutomationProperties.Name="Audio or video link" ToolTip="Paste a public HTTPS or HTTP link" />
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="SAVE TO" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6" />
                  <TextBlock x:Name="DownloadFolder" Text="Choose a local folder" Foreground="{DynamicResource BDDE2D9}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="DownloadBrowse" Content="Choose folder…" Grid.Column="1" Margin="16,0,0,0" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,20,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button x:Name="DownloadExistingMode" Content="Existing playlist"/><Button x:Name="DownloadNewMode" Content="New playlist"/></StackPanel>
              <StackPanel x:Name="DownloadExistingControls" Margin="0,0,0,14">
                <TextBlock Text="ADD DOWNLOADS TO" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5" />
                <ComboBox x:Name="DownloadPlaylistTarget" MinWidth="420" HorizontalAlignment="Left" ToolTip="Choose an existing playlist or All music"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextWrapping="Wrap" MaxWidth="520"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </StackPanel>
              <WrapPanel x:Name="DownloadNewControls" Margin="0,0,0,14" Visibility="Collapsed">
                <CheckBox x:Name="DownloadPlaylist" Content="Download entire playlist" Foreground="{DynamicResource BDDE2D9}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel>
                  <TextBlock Text="Playlist / folder name" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5" />
                  <TextBox x:Name="DownloadPlaylistName" Text="Downloaded playlist" Width="220" MaxLength="64" ToolTip="Creates a folder with this name inside Save to, and a playlist in your library" />
                </StackPanel>
              </WrapPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DownloadStart" Content="＋  Add to download queue" Background="{DynamicResource BC1D3A8}" Foreground="{DynamicResource B20291E}" />
                <Button x:Name="DownloadCancel" Content="Cancel active" IsEnabled="False" />
                <TextBlock Text="MP3 audio" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
              <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="100" Foreground="{DynamicResource BC1D3A8}" Background="{DynamicResource B303B31}" BorderThickness="0" Margin="0,18,0,10" />
              <TextBlock x:Name="DownloadStatus" Text="Ready. Finished downloads are added to your library." TextWrapping="Wrap" Foreground="{DynamicResource BBDCCB0}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,14,0,0">
              <TextBlock Text="DOWNLOAD QUEUE &amp; HISTORY" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
              <ListBox x:Name="DownloadJobs" MinHeight="70" MaxHeight="150" DisplayMemberPath="Display"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,4"><Button x:Name="DownloadRetry" Content="Retry"/><Button x:Name="DownloadJobCancel" Content="Cancel"/><Button x:Name="DownloadOpenFolder" Content="Open folder"/><Button x:Name="DownloadDetailsToggle" Content="Show details"/></StackPanel>
              <TextBox x:Name="DownloadLog" Visibility="Collapsed" MinHeight="70" MaxHeight="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Download details" />
              <TextBlock x:Name="DownloadToolsStatus" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="PlaylistPane" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" Margin="32,26,32,20" Panel.ZIndex="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22"><TextBlock Text="PLAYLISTS / YOUR SHELVES" Foreground="{DynamicResource BA9BE96}" FontSize="11"/><TextBlock Text="Playlists" FontFamily="{DynamicResource ThemeDisplayFont}" FontStyle="Italic" FontSize="48" Margin="0,6,0,3"/><TextBlock Text="Open a collection, or right-click a card to change its square cover." Foreground="{StaticResource Muted}"/></StackPanel>
        <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="PlaylistGrid"/></ScrollViewer><TextBlock x:Name="PlaylistGridEmpty" Text="No playlists yet. Add a music folder or create one yourself." Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Top" Margin="0,20,0,0"/></Grid>
      </Grid>
      <Border Grid.RowSpan="2" x:Name="QueueDrawer" Grid.ColumnSpan="2" Panel.ZIndex="20" Width="340" HorizontalAlignment="Right" Margin="0,0,24,12" Background="{DynamicResource B1C211D}" BorderBrush="{DynamicResource BC1D3A8}" BorderThickness="2" Padding="20" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel>
              <Button x:Name="CloseQueueButton" Content="×" DockPanel.Dock="Right" HorizontalAlignment="Right" />
              <TextBlock Text="UP NEXT" FontFamily="{DynamicResource ThemeDisplayFont}" FontSize="28" />
            </DockPanel>
            <TextBlock x:Name="QueueCount" Text="0 tracks" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button x:Name="QueueUpButton" Content="↑" ToolTip="Move earlier"/><Button x:Name="QueueDownButton" Content="↓" ToolTip="Move later"/><Button x:Name="QueueRemoveButton" Content="Remove" ToolTip="Remove from queue"/></StackPanel>
          <ListBox x:Name="Queue" DisplayMemberPath="Title" FontSize="11" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
        </DockPanel>
      </Border>
    </Grid>
    <Grid x:Name="ExpandedView" Focusable="True" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource B161917}" Margin="0" Grid.RowSpan="3" Panel.ZIndex="30" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="32,24,32,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="FullscreenButton" Content="⛶ Fullscreen" ToolTip="F11" />
          <Button x:Name="ExpandedLyricsButton" Content="Lyrics" />
          <Button x:Name="CloseExpandedButton" Content="Back to library" Margin="0" ToolTip="Esc" />
        </StackPanel>
        <TextBlock Text="DIGITONE / LIVE SIGNAL" Foreground="{DynamicResource BA9BE96}" FontSize="15" VerticalAlignment="Center" />
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="36,20,36,12">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Width="80" Height="80" Background="{DynamicResource B354233}" BorderBrush="{DynamicResource BC1D3A8}" BorderThickness="1"><Grid><TextBlock x:Name="ExpandedArtFallback" Text="♪" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ExpandedArt" Stretch="UniformToFill"/></Grid></Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="ExpandedTitle" Text="Something worth listening to." FontFamily="{DynamicResource ThemeDisplayFont}" FontStyle="Italic" FontSize="42" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
        <TextBlock x:Name="ExpandedDetail" Text="Choose a song, then settle in." Foreground="{DynamicResource BA7B39F}" FontSize="15" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
</StackPanel></Grid>
<WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
<Button x:Name="ModeWaveform" Content="Waveform" Padding="12,7"/><Button x:Name="ModeSpectrum" Content="Spectrum" Padding="12,7"/><Button x:Name="ModeRadial" Content="Radial" Padding="12,7"/><Button x:Name="ModePrism" Content="Prism" Padding="12,7"/><Button x:Name="ModePulse" Content="Pulse" Padding="12,7"/>
</WrapPanel></StackPanel>
<Border Grid.Row="2" Margin="36,4,36,8" CornerRadius="0" Padding="24" BorderBrush="{DynamicResource B344537}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource C253529}" Offset="0" />
            <GradientStop Color="{DynamicResource C19221C}" Offset="0.6" />
            <GradientStop Color="{DynamicResource C1D2A22}" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Canvas x:Name="ExpandedWaveform" Background="Transparent" ClipToBounds="True" Cursor="Arrow" MinHeight="70" />
      </Border>
      <TextBlock Grid.Row="3" x:Name="ExpandedHint" Text="Play a song to see its waveform" Foreground="{DynamicResource B9CAB97}" FontSize="11" HorizontalAlignment="Center" Margin="24,12,24,22" />
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource B202620}" BorderBrush="{DynamicResource B343C33}" CornerRadius="0" Margin="12,0,12,10" BorderThickness="1" Padding="22,12" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition />
          <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PlayerTitle" Text="Nothing playing. Yet." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <TextBlock x:Name="PlayerDetail" Text="A good place to slow down." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </StackPanel>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="25" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ShuffleButton" Content="⤨" ToolTip="Shuffle" Background="Transparent" Padding="12,6" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button x:Name="PreviousButton" Content="|◀" ToolTip="Previous" Background="Transparent" Padding="12,6" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button x:Name="PlayButton" Content="▶" ToolTip="Play / pause (Space)" Background="{DynamicResource BC1D3A8}" Foreground="{DynamicResource B20291E}" Padding="21,7" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button x:Name="NextButton" Content="▶|" ToolTip="Next" Background="Transparent" Padding="12,6" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Button x:Name="RepeatButton" Content="↻" ToolTip="Repeat mode" Background="Transparent" Padding="12,6" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition />
              <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" Value="0" AutomationProperties.Name="Playback position" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
            <TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          </Grid>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MuteButton" Content="♪" ToolTip="Mute" Background="Transparent" Padding="8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Slider x:Name="Volume" Width="94" Minimum="0" Maximum="1" Value="0.7" AutomationProperties.Name="Volume" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>




